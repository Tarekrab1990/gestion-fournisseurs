# Copier en .env (Docker) ou dans /etc/gestion-fournisseurs.env (systemd).

# --- Obligatoire en production ---------------------------------------------
# Clé de signature des sessions. Sans elle, un fichier data/secret.key est créé
# au premier démarrage ; fixez-la pour que les sessions survivent à une mise à
# jour, et impérativement si plusieurs instances servent la même base.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Emplacement des données : base, pièces jointes, clé de session.
# C'est le seul dossier à sauvegarder.
DATA_DIR=./data

# Mettre à 1 dès que l'application est servie en HTTPS.
COOKIE_SECURE=0

# --- Premier démarrage ------------------------------------------------------
# Mot de passe du compte « admin » créé au tout premier lancement.
# Laissé vide, un mot de passe aléatoire est généré et affiché dans la console.
ADMIN_PASSWORD=

# --- Base de données --------------------------------------------------------
# Vide      -> SQLite dans DATA_DIR/gestion.db (par défaut, aucun service à installer)
# PostgreSQL -> postgresql://utilisateur:motdepasse@hote:5432/base
#              nécessite : pip install "psycopg[binary]"
DATABASE_URL=

# --- Messagerie (relances) --------------------------------------------------
# Le serveur, le port et l'expéditeur se règlent dans l'interface.
# Seul le mot de passe passe par l'environnement, pour ne jamais être en base.
SMTP_PASSWORD=

# --- Divers -----------------------------------------------------------------
SESSION_HOURS=10
HOST=127.0.0.1
PORT=8000
